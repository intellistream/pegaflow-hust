{
  "schema_version": "1.0",
  "bundle_id": "vllm-hust.pegaflow",
  "bundle_version": "0.23.3",
  "host_api_range": ">=1,<2",
  "components": [
    {
      "component_id": "scheduler",
      "contracts": ["vllm.kv_connector.scheduler.v1"],
      "execution_planes": ["scheduler"],
      "isolation": "trusted_in_process",
      "implementation_ref": "pegaflow.connector.facade:PegaKVConnector",
      "permissions": ["ipc", "network_egress"]
    },
    {
      "component_id": "worker",
      "contracts": ["vllm.kv_connector.worker.v1"],
      "execution_planes": ["worker", "device"],
      "isolation": "trusted_in_process",
      "implementation_ref": "pegaflow.connector.facade:PegaKVConnector",
      "permissions": ["device_access", "ipc", "network_egress"]
    },
    {
      "component_id": "telemetry",
      "contracts": ["vllm.kv_connector.telemetry.v1"],
      "execution_planes": ["api"],
      "isolation": "trusted_in_process",
      "implementation_ref": "pegaflow.connector.telemetry:PegaKVTelemetryProvider",
      "permissions": []
    }
  ]
}
